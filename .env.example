# General Configuration
SECRET_KEY=changeme_in_production_super_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Application Security Parameters (Added for Vane-Truth Setup Alignment)
APPLICATION_CRYPTO_SECRET_KEY=your_crypto_secret_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Database Settings
DB_HOST=db
DB_NAME=codabench
DB_USER=postgres
DB_PASSWORD=postgres

# Message Queue
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Monitoring, Analytics & External Services
SENTRY_DSN=https://sentry.io
FLASK_ENV=development
TEXT_MODEL_API_KEY=your_model_api_key_here
TEXT_MODEL_BASE_URL=https://openrouter.ai
TEXT_MODEL=inception/mercury-2.5

# Authentication & Third-Party
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=
GITHUB_TOKEN=ghp_your_automation_token_placeholder
